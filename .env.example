MONGO_USER=user
MONGO_PASS=password
MONGO_HOST=host
HTTP_HOST=localhost
HTTP_PORT=5018
EDITORES=editor1,editor2,editor3

# API de Inteligencia Artificial (Traductor DeepSeek)
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=deepseek-v4-flash
OPENAI_BASE_URL=https://api.deepseek.com/v1

# Docling remoto (servidor opcional para extracción de mayor precisión)
DOCLING_IP=192.168.1.47
DOCLING_PORT=5020

# Motor de extracción por defecto
# Valores: "pymupdf" (actual) o "docling" (remoto, más preciso)
MOTOR_EXTRACCION=pymupdf

# Servidor RAG (FastAPI en puerto desacoplado)
RAG_HTTP_HOST=0.0.0.0
RAG_HTTP_PORT=5022
RAG_USER=rag
RAG_API_KEY=

